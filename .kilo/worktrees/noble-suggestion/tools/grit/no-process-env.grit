// SOT: no-process-env, grit-plugin, env-lint
// Every environment variable is declared once in @foodos/env, so a missing secret fails
// at boot rather than on a customer's request.
language js

`process.env` where {
  register_diagnostic(span=$match, message="Read environment variables through @foodos/env. Add the variable there and to .env.example.", severity="error")
}
