# Every variable here is declared once in packages/env/src/index.ts.
# Adding one means one line there and one line here - nothing else reads process.env.

# ── Transport ────────────────────────────────────────────────────────────────
# 127.0.0.1, not localhost: the compose file publishes NATS on 127.0.0.1:4222 (IPv4 only)
# and Node resolves localhost to ::1 first, so "localhost" gives ECONNREFUSED ::1:4222.
NATS_URL="nats://127.0.0.1:4222"
# The bus authenticates every connection. Each process needs its own identity and
# key - see infra/nats/RUNBOOK.md. Development keys already exist under
# infra/nats/creds/<user>.env; do not hand-write these two locally.
#
# Locally, leave both OUT of .env entirely. Each service loads its own through
# --env-file, and Node's --env-file will not overwrite a variable that is already in
# the environment - so an empty one exported from here shadows the real credential and
# every service dies with `authentication error - Nkey ""`. Set them only where one
# process has one identity, which is a deployment, not a dev machine.
# NATS_USER=""
# NATS_NKEY_SEED=""
# Signs the request envelope. Services reject any envelope they cannot verify,
# so a rogue publisher on the bus cannot forge an org id.
# Generate with: openssl rand -base64 32
ENVELOPE_SECRET=""

# ── Data (each service owns its own schema; same instance is fine locally) ────
DATABASE_URL="postgresql://foodos:foodos@localhost:5432/foodos"

# ── Identity ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Billing (optional: without it everyone is on the free plan) ───────────────
AUTUMN_SECRET_KEY=""
# Development only, and only with no AUTUMN_SECRET_KEY: the plan every organisation is
# treated as being on. Without it everyone is "starter", and starter allows no restaurant
# at all - so nothing downstream of a restaurant (branches, places, QR codes, the table
# cart) can be reached on a laptop. Usage is not counted, so limits never bite.
# One of: starter, growth, pro, enterprise. Anything else fails at boot, as does setting
# this in production or beside a real Autumn key.
DEV_PLAN=""

# ── Rate limiting (optional: falls back to in-process) ───────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_DEV=""
# Only for a genuine single-instance deploy with no Upstash. Every replica would
# otherwise enforce its own limit, turning a max of N into N x replicas.
RATE_LIMIT_ALLOW_IN_MEMORY=""
